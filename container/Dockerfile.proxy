# The SayDo egress proxy, containerised so it can BE the only route out.
#
# Enforcement needs the proxy to sit on the network the server-under-test can
# reach, while the server itself sits on a network with no route off-host.
# Two networks make that true rather than hoped for:
#
#   saydo-inside   --internal (no route off-host). The server lives here.
#                  The proxy is also attached here, as "saydo-proxy".
#   saydo-outside  a normal bridge. ONLY the proxy is attached here.
#
# So the server's single reachable neighbour is the proxy, and the proxy is
# the single thing that can reach the internet. A tool that ignores proxy
# environment variables does not get out -- it has nowhere to go.

FROM python:3.12-slim

# Build from the repository root: docker build -f container/Dockerfile.proxy .
WORKDIR /app
COPY tools/egress_proxy.py /app/egress_proxy.py
COPY tools/dns_sink.py /app/dns_sink.py
# Content inspection needs both of these, and neither was here. With
# SAYDO_INSPECT=1 the proxy imported sandbox_ca at startup, raised
# ModuleNotFoundError, and died before binding -- so every contained run that
# planted a canary ran against a sandbox with no proxy in it at all. That is
# why data.stays-put came back not-covered for 379 servers: not a property of
# those servers, a missing COPY.
COPY tools/sandbox_ca.py /app/sandbox_ca.py
COPY tools/canary.py /app/canary.py
# sandbox_ca mints the interception CA; without this the import above succeeds
# and the first HTTPS interception fails instead, which is worse because it
# fails later and looks like the tool's doing.
RUN pip install --no-cache-dir --quiet "cryptography>=42"

# This container deliberately runs as root, because it binds port 53 to act as
# the sandbox's only nameserver. It is SayDo's own trusted infrastructure and
# never runs the code under test -- the isolation that matters is applied to
# the tool's container, which drops every capability and runs unprivileged.

# Listen on all interfaces inside the container so the server container can
# reach it by network alias. SAYDO_ALLOW, when set, is a comma-separated
# allowlist and switches the proxy from observing to REFUSING.
ENV SAYDO_EGRESS_LOG=/tmp/egress.log
# Act as the sandbox's nameserver as well as its proxy, so a lookup that
# bypasses the proxy is still recorded.
ENV SAYDO_DNS=1
EXPOSE 8888
EXPOSE 53/udp

CMD ["python", "-u", "/app/egress_proxy.py", "8888", "--bind", "0.0.0.0"]
