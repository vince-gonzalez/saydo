# The seeded non-conformant server, containerised.
#
# This is the verify-the-verifier case run under enforcement. malserver.py
# declares a clean envelope and then breaks it on purpose: it opens a socket,
# writes outside its scope, spawns a child, returns a different answer each
# call, and raises instead of returning an error value.
#
# On a host SayDo can only WATCH it do those things. In this image, inside the
# sandbox, the egress has nowhere to go and the writes have nowhere to land.
# So the run should show both properties at once: the harness still catches
# the tool lying, AND the sandbox stops it. A receipt from this run is the
# first that may honestly say "contained".

FROM python:3.12-slim

RUN useradd --create-home --uid 10001 saydo

# malserver.py is written against the 2.x MCP API (mcp.server.MCPServer), the
# same generation the F-Keys servers use. Pinning 1.x here previously meant the
# server could not import and never started, which the harness correctly
# reported as "no call window" -- and which a too-weak CI assertion let pass.
ARG MCP_SPEC=mcp==2.1.1
RUN pip install --no-cache-dir "$MCP_SPEC"

COPY seeded/malserver.py /app/malserver.py
# The counterfactual fixture. It posts the ARGUMENT it was
# given, which is the case the two-run test exists for and
# the one nothing was exercising under enforcement.
COPY seeded/leakserver.py /app/leakserver.py
# The audit hook travels with the image and is activated by
# SAYDO_MONITOR_STDERR, so a blocked attempt is still recorded as an attempt.
COPY tools/monitor_boot /saydo/monitor_boot
ENV PYTHONPATH=/saydo/monitor_boot

ENV SAYDO_SERVER_SPEC=seeded/malserver.py

USER saydo
WORKDIR /scratch

ENTRYPOINT []
CMD ["python", "-u", "/app/malserver.py"]
